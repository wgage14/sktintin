#nop ============================================================
#nop  overlay.tin - On-screen UI for sktintin.
#nop
#nop  This file owns the screen split (top = compass, bottom = tick).
#nop  Layout, anchored to the top-right for portrait play:
#nop
#nop      +----+ +----+ +----+
#nop      | NW | |  N | | NE |   <- 3x3 button grid, each btn_w x btn_h
#nop      +----+ +----+ +----+
#nop      | W  | |  + | |  E |
#nop      +----+ +----+ +----+
#nop      | SW | |  S | | SE |
#nop      +----+ +----+ +----+
#nop      --------[ scrollback ]--------
#nop      Next tick in ~37 sec  ########____   <- row -2 (status)
#nop      >                                     <- row -1 (input)
#nop
#nop  Button size/spacing is tunable via the geometry vars below.
#nop  Mouse tracking is enabled in sk.tin so taps fire #button regions.
#nop ============================================================


#nop ============================================================
#nop  Section 0 - Geometry + screen split
#nop ============================================================

#nop Tap-target size. Bump btn_w/btn_h for bigger buttons, gap_* for
#nop more space between them. Top split height is derived from these.
#variable {btn_w} {6}
#variable {btn_h} {2}
#variable {gap_x} {2}
#variable {gap_y} {1}
#variable {overlay_cols} {80}

#math {compass_top} {$btn_h * 3 + $gap_y * 2}
#split $compass_top 1


#nop ============================================================
#nop  Section 1 - Compass (8-direction tap pad, top-right)
#nop ============================================================

#alias {overlay_compass_render}
{
    #math {block_w} {$btn_w * 3 + $gap_x * 2};
    #math {cs}      {$overlay_cols - $block_w + 1};

    #nop column starts (x0..x2) and ends (x0e..x2e)
    #math {x0}  {$cs};
    #math {x1}  {$cs + $btn_w + $gap_x};
    #math {x2}  {$cs + 2 * ($btn_w + $gap_x)};
    #math {x0e} {$x0 + $btn_w - 1};
    #math {x1e} {$x1 + $btn_w - 1};
    #math {x2e} {$x2 + $btn_w - 1};

    #nop row starts (y0..y2) and ends (y0e..y2e)
    #math {y0}  {1};
    #math {y1}  {1 + $btn_h + $gap_y};
    #math {y2}  {1 + 2 * ($btn_h + $gap_y)};
    #math {y0e} {$y0 + $btn_h - 1};
    #math {y1e} {$y1 + $btn_h - 1};
    #math {y2e} {$y2 + $btn_h - 1};

    #nop draw cells: white-on-blue buttons, centered label
    #draw <074> CALIGN tile $y0 $x0 $y0e $x0e {NW};
    #draw <074> CALIGN tile $y0 $x1 $y0e $x1e {N};
    #draw <074> CALIGN tile $y0 $x2 $y0e $x2e {NE};
    #draw <074> CALIGN tile $y1 $x0 $y1e $x0e {W};
    #draw <034> CALIGN tile $y1 $x1 $y1e $x1e {+};
    #draw <074> CALIGN tile $y1 $x2 $y1e $x2e {E};
    #draw <074> CALIGN tile $y2 $x0 $y2e $x0e {SW};
    #draw <074> CALIGN tile $y2 $x1 $y2e $x1e {S};
    #draw <074> CALIGN tile $y2 $x2 $y2e $x2e {SE};

    #nop clickable regions (taps -> direction commands)
    #button {$y0 $x0 $y0e $x0e} {nw};
    #button {$y0 $x1 $y0e $x1e} {n};
    #button {$y0 $x2 $y0e $x2e} {ne};
    #button {$y1 $x0 $y1e $x0e} {w};
    #button {$y1 $x2 $y1e $x2e} {e};
    #button {$y2 $x0 $y2e $x0e} {sw};
    #button {$y2 $x1 $y2e $x1e} {s};
    #button {$y2 $x2 $y2e $x2e} {se};
}


#nop ============================================================
#nop  Section 2 - Tick timer (bottom status row)
#nop
#nop  Ported from Mudlet skmudlet (Triggers/ticktimer + Timers).
#nop  Model: 61-second wrap counter. Increments once per second;
#nop  trigger patterns below reset it to 0 when a tick is observed.
#nop  Counter wraps at 61 so the display stays sane if reset
#nop  triggers miss a tick.
#nop ============================================================

#variable {tick_time}      {0}
#variable {tick_max}       {61}
#variable {tick_bar_width} {16}

#alias {overlay_tick_render}
{
    #math {tick_left} {$tick_max - $tick_time};
    #math {bar_fill}  {($tick_time * $tick_bar_width) / $tick_max};
    #math {bar_empty} {$tick_bar_width - $bar_fill};

    #nop Build a block-character bar: full blocks fill toward the tick.
    #variable {bar} {};
    #if {$bar_fill  > 0} {#loop {1} {$bar_fill}  {x} {#variable {bar} {$bar█}}};
    #if {$bar_empty > 0} {#loop {1} {$bar_empty} {x} {#variable {bar} {$bar░}}};

    #nop Space before "sec" delimits the variable (avoids the $var+text trap).
    #draw <fca> tile -2 1 -2 -1 { Next tick in ~$tick_left sec  $bar};
}

#alias {tick_reset}
{
    #variable {tick_time} {0};
    overlay_tick_render;
}

#nop Conditional reset for weather messages: only re-anchor if we're
#nop already near a tick boundary (matches Mudlet weather_messages).
#alias {tick_weather_reset}
{
    #if {$tick_time >= 55 || $tick_time <= 5} {tick_reset};
}

#ticker {tick_update}
{
    #math {tick_time} {$tick_time + 1};
    #if {$tick_time >= $tick_max} {#variable {tick_time} {0}};
    overlay_tick_render;
} {1.0}


#nop ============================================================
#nop  Section 3 - Tick reset triggers
#nop
#nop  Hard reset (definitive tick markers - from Mudlet tick_echoes).
#nop  Each line is one MUD output pattern; %1 = wildcard word.
#nop ============================================================

#action {You are hungry.}                                  {tick_reset}
#action {You are thirsty.}                                 {tick_reset}
#action {Your pulse slows to normal.}                      {tick_reset}
#action {The comforts of the inn put you at ease.}         {tick_reset}
#action {You feel an effervescent energy dissipate into your dreams.}                 {tick_reset}
#action {Death arrives and escorts your soul to the spirit world.}                    {tick_reset}
#action {A magical gate vanishes into thin air.}           {tick_reset}
#action {The mystic portal vanishes into thin air.}        {tick_reset}
#action {A glowing portal snaps into existence in the midst of the stones!}           {tick_reset}
#action {The city stirs to shake off the night as a new day begins.}                  {tick_reset}
#action {The city slows, drawing in on itself as dusk gathers and another day ends.}  {tick_reset}
#action {In the distance, Peacekeepers call the changing of the guard.}               {tick_reset}
#action {The Teronian Temple bell strikes six times, ringing loudly through the streets.} {tick_reset}
#action {The deathly silence is broken by a muffled whistle of arctic air.}           {tick_reset}
#action {A slight wind blows a chill into living tissue.}  {tick_reset}
#action {Touched by a light breeze, the clouds rearrange themselves.}                 {tick_reset}
#action {The shuffling of feet can be heard in the distance.}                         {tick_reset}
#action {The clinking of metal on stone resounds through the caves.}                  {tick_reset}
#action {You hear a distant rumble as stone shifts somewhere deep below you.}         {tick_reset}
#action {The plants recede back into the ground.}          {tick_reset}
#action {The stones glow eerily...}                        {tick_reset}
#action {Drip...Drip...Drip...}                            {tick_reset}
#action {You are ready to summon another treant.}          {tick_reset}
#action {The white aura around your body fades.}           {tick_reset}
#action {Your symbol slowly begins to melt and reform!}    {tick_reset}
#action {A bracer made of mithril scales on %1's wrist shimmers slightly.}            {tick_reset}
#action {A corpse of %1 decays into dust.}                 {tick_reset}
#action {The %1 crumbles into dust.}                       {tick_reset}
#action {%1 regains consciousness and rises unsteadily to %2 feet.}                   {tick_reset}
#action {An aura of divine blessing surrounds %1.}         {tick_reset}
#action {A ruddy pebble on a chain worn by %1 glows red momentarily.}                 {tick_reset}
#action {The ether wire phases partially out of existence.} {tick_reset}

#nop ---- Soft reset: weather messages, only near tick boundaries.
#action {It's breezy.}                                     {tick_weather_reset}
#action {It's hot out here.}                               {tick_weather_reset}
#action {It's cold!}                                       {tick_weather_reset}
#action {It's mild out today.}                             {tick_weather_reset}
#action {It's nice and warm out.}                          {tick_weather_reset}
#action {It's cool out here.}                              {tick_weather_reset}
#action {It's a bit nippy here.}                           {tick_weather_reset}
#action {It's really c-c-c-cold!!}                         {tick_weather_reset}
#action {It's hotter than anyone could imagine.}           {tick_weather_reset}
#action {It's really, really hot here.  A slight breeze would really improve things.} {tick_weather_reset}
#action {It's raining lightly.}                            {tick_weather_reset}
#action {It rains a bit harder.}                           {tick_weather_reset}
#action {The rain stops.}                                  {tick_weather_reset}
#action {The rain is falling less heavily now.}            {tick_weather_reset}
#action {The rain turns to snow.}                          {tick_weather_reset}
#action {The snow turns to a cold rain.}                   {tick_weather_reset}
#action {A light drizzle is falling here.}                 {tick_weather_reset}
#action {A light snow is falling amidst an unsettled wind.}   {tick_weather_reset}
#action {A lightly falling snow is being driven by a strong wind.} {tick_weather_reset}
#action {The snow is coming down faster now.}              {tick_weather_reset}
#action {The snow has let up a little.}                    {tick_weather_reset}
#action {It stops snowing.}                                {tick_weather_reset}
#action {There's a blizzard out here, making it quite difficult to see.}              {tick_weather_reset}
#action {Drifts in the snow are being formed by the wind.}    {tick_weather_reset}
#action {A cool breeze wafts by.}                          {tick_weather_reset}
#action {A warm pocket of air is rolling through here.}    {tick_weather_reset}
#action {A blast of freezing wind chills you to the bone.}    {tick_weather_reset}
#action {A freezing wind blows gently, but firmly against all obstacles in the area.} {tick_weather_reset}
#action {The breeze dies away to nothing.}                 {tick_weather_reset}
#action {The wind begins to blow from the %1.}             {tick_weather_reset}
#action {The wind changes and begins blowing from the %1.} {tick_weather_reset}
#action {The wind isn't very strong here, but the cold makes it quite noticeable.}    {tick_weather_reset}
#action {The wind and a bit of rain hint at the possibility of a storm.}              {tick_weather_reset}
#action {A few drops of rain are falling amidst a fierce windstorm.}                  {tick_weather_reset}
#action {The arid wind brings no relief.}                  {tick_weather_reset}
#action {The sun slowly disappears in the %1.}             {tick_weather_reset}


#nop ============================================================
#nop  Section 4 - Scrollback control
#nop
#nop  In split mode TinTin++ owns the screen, so the terminal's native
#nop  scroll is disabled. Re-bind scrolling to the #buffer command.
#nop  `#buffer up/down` page the scrollback; `#buffer end` returns to live.
#nop ============================================================

#nop --- Touchscreen swipe (Termux). %0 = direction string. The exact
#nop --- spelling varies, so we accept common variants. To discover the
#nop --- real value on your device run `#config {mouse info} {on}` and
#nop --- swipe once; then trim these to whatever fires.
#event {SWIPED}
{
    #if {"%0" == "down" || "%0" == "DOWN" || "%0" == "d"} {#buffer up};
    #if {"%0" == "up"   || "%0" == "UP"   || "%0" == "u"} {#buffer down};
}

#nop --- Keyboard fallback (also handy when testing on desktop).
#nop PageUp / PageDown scroll; End jumps back to the live feed.
#macro {\e[5~} {#buffer up}
#macro {\e[6~} {#buffer down}
#macro {\e[F}  {#buffer end}


#nop ============================================================
#nop  Section 5 - Resize handling and initial render
#nop ============================================================

#event {SCREEN SIZE}       {#variable {overlay_cols} {%1}; overlay_compass_render; overlay_tick_render}
#event {SCREEN RESIZE}     {#variable {overlay_cols} {%1}; overlay_compass_render; overlay_tick_render}
#event {SESSION CONNECTED} {overlay_compass_render; overlay_tick_render}

#nop Try to pull current width up front (event will correct if needed).
#screen {get} {COLS} {overlay_cols}

overlay_compass_render
overlay_tick_render
