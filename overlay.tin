#nop ============================================================
#nop  overlay.tin - On-screen UI for sktintin.
#nop
#nop  The reserved band is at the BOTTOM, just above the input line:
#nop
#nop    --------------------[ scrollback ]--------------------
#nop    ###Next tick ~37 s###     +--+ +--+ +--+
#nop                              |NW| | N| |NE|
#nop    +---+ +---+ +---+ +---+   +--+ +--+ +--+
#nop    | 1 | | 2 | | 3 | |Wo|..  | W| |Lk| | E|
#nop    +---+ +---+ +---+ +---+   +--+ +--+ +--+
#nop                              |SW| | S| |SE|
#nop    >                                  (input)
#nop
#nop  Right ~1/3: 3x3 nav buttons (center = look). Left ~2/3: tick bar
#nop  (top half, text embedded in the bar) over a 1/2/3/worth/score row.
#nop
#nop  TinTin++ gotchas worked around here:
#nop   - #draw/#button SQUARE args drop bare $var coords, so coordinates go
#nop     through the ov_tile/ov_btn helpers as positional %1..%4 args.
#nop   - #nop comments must NOT contain a semicolon and must NOT sit inside
#nop     a braced body (text after a semicolon would run / be sent to MUD).
#nop ============================================================


#nop ============================================================
#nop  Section 0 - Geometry, split, draw helpers
#nop ============================================================

#nop Tunables. btn_w is derived (right third of the screen). Set btn_h and
#nop gaps for button height and spacing. Band height = btn_h*3 + gap_y*2.
#variable {btn_h} {2}
#variable {gap_x} {1}
#variable {gap_y} {1}
#variable {overlay_rows} {24}
#variable {overlay_cols} {80}

#math {band_h} {$btn_h * 3 + $gap_y * 2}
#split 0 $band_h

#nop ov_tile: filled centered tile. Args %1 color %2 top %3 left %4 bottom
#nop %5 right. Text comes from $ovtxt so it may contain spaces.
#alias {ov_tile}
{
    #draw %1 CALIGN tile %2 %3 %4 %5 {$ovtxt};
}

#nop ov_btn: button tile plus click region. Args %1 top %2 left %3 bottom
#nop %4 right %5 label %6 command.
#alias {ov_btn}
{
    #draw <074> CALIGN tile %1 %2 %3 %4 {%5};
    #button {%1 %2 %3 %4} {%6};
}

#nop overlay_geom: compute all shared layout values into g* globals from
#nop the current rows/cols. Called at the start of each render alias.
#alias {overlay_geom}
{
    #math {gbh}   {$btn_h * 3 + $gap_y * 2};
    #math {gtop}  {$overlay_rows - $gbh};
    #math {gbot}  {$overlay_rows - 1};
    #math {gthird} {$overlay_cols / 3};
    #math {gbw}   {($gthird - 2 * $gap_x) / 3};
    #if {$gbw < 2} {#variable {gbw} {2}};
    #math {gcl1}  {$overlay_cols - ($gbw * 3 + $gap_x * 2) + 1};
    #math {gcl2}  {$gcl1 + $gbw + $gap_x};
    #math {gcl3}  {$gcl1 + 2 * ($gbw + $gap_x)};
    #math {gcr1}  {$gcl1 + $gbw - 1};
    #math {gcr2}  {$gcl2 + $gbw - 1};
    #math {gcr3}  {$gcl3 + $gbw - 1};
    #math {grt1}  {$gtop};
    #math {grt2}  {$gtop + $btn_h + $gap_y};
    #math {grt3}  {$gtop + 2 * ($btn_h + $gap_y)};
    #math {grb1}  {$grt1 + $btn_h - 1};
    #math {grb2}  {$grt2 + $btn_h - 1};
    #math {grb3}  {$grt3 + $btn_h - 1};
    #math {gleftw} {$gcl1 - 2};
    #math {ghalf} {$gbh / 2};
    #math {gtickb} {$gtop + $ghalf - 1};
    #math {gxtop} {$gtop + $ghalf};
}


#nop ============================================================
#nop  Section 1 - Compass (9 nav buttons, right side, center = look)
#nop ============================================================

#alias {overlay_compass_render}
{
    overlay_geom;
    ov_btn $grt1 $gcl1 $grb1 $gcr1 NW nw;
    ov_btn $grt1 $gcl2 $grb1 $gcr2 N n;
    ov_btn $grt1 $gcl3 $grb1 $gcr3 NE ne;
    ov_btn $grt2 $gcl1 $grb2 $gcr1 W w;
    ov_btn $grt2 $gcl2 $grb2 $gcr2 Lk look;
    ov_btn $grt2 $gcl3 $grb2 $gcr3 E e;
    ov_btn $grt3 $gcl1 $grb3 $gcr1 SW sw;
    ov_btn $grt3 $gcl2 $grb3 $gcr2 S s;
    ov_btn $grt3 $gcl3 $grb3 $gcr3 SE se;
}


#nop ============================================================
#nop  Section 2 - Extra command buttons (left, bottom half)
#nop  A row of: 1  2  3  worth  score  sleep/stand
#nop
#nop  The 6th button toggles: it shows + sends "sleep", then flips to
#nop  show + send "stand", and back. rest_toggle sends the current state,
#nop  flips it, then repaints the row to update the label.
#nop ============================================================

#variable {rest_state} {sleep}

#alias {rest_toggle}
{
    $rest_state;
    #if {"$rest_state" == "sleep"} {#variable {rest_state} {stand}} {#variable {rest_state} {sleep}};
    overlay_extra_render;
}

#alias {overlay_extra_render}
{
    overlay_geom;
    #math {gew} {$gleftw / 6};
    #math {p1} {1};
    #math {p2} {$gew + 1};
    #math {p3} {$gew * 2 + 1};
    #math {p4} {$gew * 3 + 1};
    #math {p5} {$gew * 4 + 1};
    #math {p6} {$gew * 5 + 1};
    #math {q1} {$gew};
    #math {q2} {$gew * 2};
    #math {q3} {$gew * 3};
    #math {q4} {$gew * 4};
    #math {q5} {$gew * 5};
    ov_btn $gxtop $p1 $gbot $q1 1 1;
    ov_btn $gxtop $p2 $gbot $q2 2 2;
    ov_btn $gxtop $p3 $gbot $q3 3 3;
    ov_btn $gxtop $p4 $gbot $q4 worth worth;
    ov_btn $gxtop $p5 $gbot $q5 score score;
    ov_btn $gxtop $p6 $gbot $gleftw $rest_state rest_toggle;
}


#nop ============================================================
#nop  Section 3 - Tick timer (left, top half, text inside the bar)
#nop
#nop  Ported from Mudlet skmudlet (ticktimer). 61-second wrap counter,
#nop  +1 per second, reset to 0 when a tick is observed (Section 4).
#nop  The bar is one color. The label sits centered in it and the filled
#nop  portion uses solid blocks, the rest light blocks. Fixed widths so
#nop  redraws overwrite in place (no smear).
#nop ============================================================

#variable {tick_time} {0}
#variable {tick_max}  {61}

#alias {overlay_tick_render}
{
    overlay_geom;
    #math {tsec} {$tick_max - $tick_time};
    #variable {tpad} {$tsec};
    #if {$tsec < 10} {#variable {tpad} { $tsec}};
    #variable {tlabel} {Next tick ~$tpad s};
    #variable {tlw} {15};
    #math {tbw} {$gleftw - 1};
    #if {$tbw < $tlw} {#variable {tbw} {$tlw}};
    #math {tls} {($tbw - $tlw) / 2};
    #if {$tls < 0} {#variable {tls} {0}};
    #math {trs} {$tbw - $tlw - $tls};
    #if {$trs < 0} {#variable {trs} {0}};
    #math {tf}  {($tick_time * $tbw) / $tick_max};
    #variable {tbar} {};
    #if {$tls > 0} {#loop {1} {$tls} {i} {#if {$i <= $tf} {#variable {tbar} {$tbar█}} {#variable {tbar} {$tbar░}}}};
    #variable {tbar} {$tbar$tlabel};
    #if {$trs > 0} {#loop {1} {$trs} {j} {#math {tp} {$tls + $tlw + $j}; #if {$tp <= $tf} {#variable {tbar} {$tbar█}} {#variable {tbar} {$tbar░}}}};
    #variable {ovtxt} {$tbar};
    ov_tile <fca> $gtop 1 $gtickb $gleftw;
}

#alias {tick_reset}
{
    #variable {tick_time} {0};
    overlay_tick_render;
}

#nop Weather messages only re-anchor near a tick boundary (Mudlet's
#nop weather_messages trigger uses the same guard).
#alias {tick_weather_reset}
{
    #if {$tick_time >= 55 || $tick_time <= 5} {tick_reset};
}

#nop #unticker first so reloading sk.tin does not stack tickers (which
#nop would advance the counter several times per second).
#unticker {tick_update}
#ticker {tick_update}
{
    #math {tick_time} {$tick_time + 1};
    #if {$tick_time >= $tick_max} {#variable {tick_time} {0}};
    overlay_tick_render;
} {1.0}


#nop ============================================================
#nop  Section 4 - Tick reset triggers
#nop
#nop  Hard reset (definitive tick markers - from Mudlet tick_echoes).
#nop  Each line is one MUD output pattern, %1 = wildcard word.
#nop ============================================================

#action {You are hungry.}                                  {tick_reset}
#action {You are thirsty.}                                 {tick_reset}
#action {Your pulse slows to normal.}                      {tick_reset}
#action {The comforts of the inn put you at ease.}         {tick_reset}
#action {You feel an effervescent energy dissipate into your dreams.}                 {tick_reset}
#action {Death arrives and escorts your soul to the spirit world.}                    {tick_reset}
#action {A magical gate vanishes into thin air.}           {tick_reset}
#action {The mystic portal vanishes into thin air.}        {tick_reset}
#action {A glowing portal snaps into existence in the midst of the stones!}           {tick_reset}
#action {The city stirs to shake off the night as a new day begins.}                  {tick_reset}
#action {The city slows, drawing in on itself as dusk gathers and another day ends.}  {tick_reset}
#action {In the distance, Peacekeepers call the changing of the guard.}               {tick_reset}
#action {The Teronian Temple bell strikes six times, ringing loudly through the streets.} {tick_reset}
#action {The deathly silence is broken by a muffled whistle of arctic air.}           {tick_reset}
#action {A slight wind blows a chill into living tissue.}  {tick_reset}
#action {Touched by a light breeze, the clouds rearrange themselves.}                 {tick_reset}
#action {The shuffling of feet can be heard in the distance.}                         {tick_reset}
#action {The clinking of metal on stone resounds through the caves.}                  {tick_reset}
#action {You hear a distant rumble as stone shifts somewhere deep below you.}         {tick_reset}
#action {The plants recede back into the ground.}          {tick_reset}
#action {The stones glow eerily...}                        {tick_reset}
#action {Drip...Drip...Drip...}                            {tick_reset}
#action {You are ready to summon another treant.}          {tick_reset}
#action {The white aura around your body fades.}           {tick_reset}
#action {Your symbol slowly begins to melt and reform!}    {tick_reset}
#action {A bracer made of mithril scales on %1's wrist shimmers slightly.}            {tick_reset}
#action {A corpse of %1 decays into dust.}                 {tick_reset}
#action {The %1 crumbles into dust.}                       {tick_reset}
#action {%1 regains consciousness and rises unsteadily to %2 feet.}                   {tick_reset}
#action {An aura of divine blessing surrounds %1.}         {tick_reset}
#action {A ruddy pebble on a chain worn by %1 glows red momentarily.}                 {tick_reset}
#action {The ether wire phases partially out of existence.} {tick_reset}

#nop Soft reset - weather messages, only near tick boundaries.
#action {It's breezy.}                                     {tick_weather_reset}
#action {It's hot out here.}                               {tick_weather_reset}
#action {It's cold!}                                       {tick_weather_reset}
#action {It's mild out today.}                             {tick_weather_reset}
#action {It's nice and warm out.}                          {tick_weather_reset}
#action {It's cool out here.}                              {tick_weather_reset}
#action {It's a bit nippy here.}                           {tick_weather_reset}
#action {It's really c-c-c-cold!!}                         {tick_weather_reset}
#action {It's hotter than anyone could imagine.}           {tick_weather_reset}
#action {It's really, really hot here.  A slight breeze would really improve things.} {tick_weather_reset}
#action {It's raining lightly.}                            {tick_weather_reset}
#action {It rains a bit harder.}                           {tick_weather_reset}
#action {The rain stops.}                                  {tick_weather_reset}
#action {The rain is falling less heavily now.}            {tick_weather_reset}
#action {The rain turns to snow.}                          {tick_weather_reset}
#action {The snow turns to a cold rain.}                   {tick_weather_reset}
#action {A light drizzle is falling here.}                 {tick_weather_reset}
#action {A light snow is falling amidst an unsettled wind.}   {tick_weather_reset}
#action {A lightly falling snow is being driven by a strong wind.} {tick_weather_reset}
#action {The snow is coming down faster now.}              {tick_weather_reset}
#action {The snow has let up a little.}                    {tick_weather_reset}
#action {It stops snowing.}                                {tick_weather_reset}
#action {There's a blizzard out here, making it quite difficult to see.}              {tick_weather_reset}
#action {Drifts in the snow are being formed by the wind.}    {tick_weather_reset}
#action {A cool breeze wafts by.}                          {tick_weather_reset}
#action {A warm pocket of air is rolling through here.}    {tick_weather_reset}
#action {A blast of freezing wind chills you to the bone.}    {tick_weather_reset}
#action {A freezing wind blows gently, but firmly against all obstacles in the area.} {tick_weather_reset}
#action {The breeze dies away to nothing.}                 {tick_weather_reset}
#action {The wind begins to blow from the %1.}             {tick_weather_reset}
#action {The wind changes and begins blowing from the %1.} {tick_weather_reset}
#action {The wind isn't very strong here, but the cold makes it quite noticeable.}    {tick_weather_reset}
#action {The wind and a bit of rain hint at the possibility of a storm.}              {tick_weather_reset}
#action {A few drops of rain are falling amidst a fierce windstorm.}                  {tick_weather_reset}
#action {The arid wind brings no relief.}                  {tick_weather_reset}
#action {The sun slowly disappears in the %1.}             {tick_weather_reset}


#nop ============================================================
#nop  Section 5 - Scrollback control
#nop
#nop  #split puts TinTin++ in full-screen mode, disabling native scroll.
#nop  Termux delivers a finger drag as mouse-wheel events.
#nop  If "#buffer up 3" errors on the count, change it to "#buffer up".
#nop ============================================================

#event {SCROLLED MOUSE WHEEL UP}   {#buffer up 3}
#event {SCROLLED MOUSE WHEEL DOWN} {#buffer down 3}

#nop Keyboard fallback - PageUp / PageDown scroll, End returns to live.
#macro {\e[5~} {#buffer up}
#macro {\e[6~} {#buffer down}
#macro {\e[F}  {#buffer end}


#nop ============================================================
#nop  Section 6 - Redraw, resize handling, initial render
#nop ============================================================

#nop redraw: type this to repaint the whole overlay. Re-pulls the current
#nop screen size, re-applies the split, clears, and renders every element.
#nop Use it after a resize that left visual artifacts.
#alias {redraw}
{
    #screen {get} {ROWS} {overlay_rows};
    #screen {get} {COLS} {overlay_cols};
    #math {band_h} {$btn_h * 3 + $gap_y * 2};
    #split 0 $band_h;
    #screen {clear} {all};
    overlay_compass_render;
    overlay_extra_render;
    overlay_tick_render;
    #screen {refresh};
}

#event {SCREEN SIZE}       {#variable {overlay_rows} {%0}; #variable {overlay_cols} {%1}; overlay_compass_render; overlay_extra_render; overlay_tick_render}
#event {SCREEN RESIZE}     {#variable {overlay_rows} {%0}; #variable {overlay_cols} {%1}; overlay_compass_render; overlay_extra_render; overlay_tick_render}
#event {SESSION CONNECTED} {overlay_compass_render; overlay_extra_render; overlay_tick_render}

#nop Pull current size up front - events correct it if it changes.
#screen {get} {ROWS} {overlay_rows}
#screen {get} {COLS} {overlay_cols}

overlay_compass_render
overlay_extra_render
overlay_tick_render
