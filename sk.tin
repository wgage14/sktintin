#nop ============================================================
#nop  sktintin - TinTin++ client for Shattered Kingdoms (sk)
#nop  Host:  mud.shatteredkingdoms.org   Port:  1996
#nop
#nop  Run from the repo root:   tt++ sk.tin
#nop  Or, inside tt++:          #read sk.tin
#nop ============================================================

#nop ---- core settings ----
#config {COMMAND ECHO}   {OFF}
#config {CONNECT RETRY}  {0}
#config {MOUSE TRACKING} {ON}

#nop ---- screen layout ----
#nop Reserve 3 rows at the top (compass) and 1 at the bottom (tick).
#nop Last arg defaults to 1 = one-line input bar below the tick row.
#split 3 1

#nop ---- modules ----
#read {events.tin}
#read {overlay.tin}

#nop ---- open session ----
#session sk mud.shatteredkingdoms.org 1996
